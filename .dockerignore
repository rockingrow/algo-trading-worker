# Keep the build context small + reproducible (deps come from uv.lock).
.git
.gitignore
.github

# Python caches / envs
__pycache__/
*.py[cod]
.venv/
env/
venv/
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Tests / examples / e2e are not needed in the runtime image
tests/
e2e/
examples/
scripts/

# Local data, logs, secrets
logs/
*.log
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db
.env
.env.*

# Docs / editor / OS noise
*.md
!README.md
.vscode/
.idea/
.claude/
.DS_Store
Thumbs.db

# Windows-only dev helpers
dev.ps1
