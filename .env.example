# FastAPI Configuration
APP_HOST=0.0.0.0
APP_PORT=8000

# Broker
BROKER_API_URL=http://localhost:8000
BROKER_API_KEY=your_broker_api_key

# NATS Configuration
NATS_URL=nats://localhost:4222
NATS_TOKEN=your_nats_token
NATS_SUBJECTS=MT5_GOLD # multiple subjects separated by commas

# Init capital
CAPITAL=1000
CAPITAL_CURRENCY=USD

# Market
MARKET_TYPE=FOREX # FOREX/CRYPTO

# ─────────────────────────────────────────────────────────────────
# MT5 Connection Configuration (required only when MARKET_TYPE=FOREX)
# (In case MT5_PATH null, module will find by registry)
# ─────────────────────────────────────────────────────────────────
MT5_SERVER=Exness-MT5Trial6
MT5_LOGIN=413652379
MT5_PASSWORD=your_password
MT5_PATH="C:/Program Files/MetaTrader 5/terminal64.exe"
MT5_NAME=WangDemo1
# Allow several strategies to hold the SAME symbol at the same time. Only FOREX
# can do this safely: each strategy trades under its own magic number
# (STRATEGY_MAGIC_MAP), so tickets, SL/TP and closes stay isolated — requires a
# HEDGING account (a netting account merges them into one position). Each
# strategy still holds at most ONE open order per symbol: a re-entry replaces
# its own position, it never stacks. false (default) rejects an entry on a
# symbol another strategy already holds.
FOREX_ALLOW_MULTI_STRATEGY_PER_SYMBOL=false

# ─────────────────────────────────────────────────────────────────
# Crypto CEX Configuration (required only when MARKET_TYPE=CRYPTO)
# CRYPTO_EXCHANGE selects the gateway via the exchange factory.
# When MARKET_TYPE=CRYPTO, no MT5 dependency is initialized.
# ─────────────────────────────────────────────────────────────────
CRYPTO_EXCHANGE=BINANCE         # currently supported: BINANCE
CRYPTO_QUOTE_ASSET=USDT         # quote currency appended to bare symbols (BTCUSD -> BTCUSDT)
CRYPTO_API_KEY=your_api_key
CRYPTO_API_SECRET=your_api_secret
CRYPTO_ACCOUNT_ID=email_address@email.com
CRYPTO_TESTNET=false            # true → use the exchange's futures testnet
# Desired exchange Position Mode, enforced at startup: the worker calls the
# exchange after connecting to switch the account into this mode.
# true = Hedge (default), false = One-way. Keeping this in sync with the account
# is what avoids Binance error -4061 ("Order's position side does not match
# user's setting.").
CRYPTO_HEDGE_MODE=true
# Crypto counterpart of FOREX_ALLOW_MULTI_STRATEGY_PER_SYMBOL. Binance USDⓈ-M
# nets every strategy on a symbol into ONE position, so there is no isolation:
# enable only if you understand that a close by one strategy affects the shared
# net position. false (default) rejects the conflicting entry.
CRYPTO_ALLOW_MULTI_STRATEGY_PER_SYMBOL=false
# Comma-separated raw signal symbols whose leverage is initialised once at
# startup. Each is set to min(exchange_max_leverage, MAX_LEVERAGE_CAP) so a
# sub-account capped at 5x stays at 5, and an unrestricted account is pinned
# to the cap. Empty value skips the init (symbols stay at their current
# exchange-side leverage). See README → "Per-symbol leverage initialisation".
CRYPTO_LEVERAGE_INIT_SYMBOLS=BTCUSDT,ETHUSDT   # e.g. BTCUSDT,ETHUSDT
MAX_LEVERAGE_CAP=10             # upper bound applied by the leverage init job
MIN_LEVERAGE_CAP=5              # last-resort floor when a -4421 cap can't be parsed
USE_CUSTOM_LEVERAGE=false # If true, force use custom leverage instead of broker crypto leverage initialization

# Strategy Configuration
SLIPPAGE_DEVIATION=100 # 100 point = $1.00
# Per-strategy magic numbers (JSON). Each listed strategy is stamped with — and
# filtered by — its own magic, isolating strategies that trade the same symbol
# at the MT5 level. Wrap in single quotes so the shell keeps the JSON intact.
STRATEGY_MAGIC_MAP='{"MT5_GOLD": 20260409}'
USE_CUSTOM_POSITION_TP1_PERCENT=true # If true, use custom TP1 percentage instead of signal's tp1_percent
POSITION_TP1_PERCENT=50
# TP1_MOVE_SL_TO_BREAKEVEN=false # Default: always use move_sl_to_be from signal. If you want to override, set this value
VOLUME_DECISION_ENABLED=true
USE_CUSTOM_RISK_PERCENTAGE=false # If true, use custom risk percentage instead of signal's risk percentage
RISK_PERCENTAGE=2.0 # Fallback when signal has no risk_percent (USE_CUSTOM_RISK_PERCENTAGE=false), or always used when USE_CUSTOM_RISK_PERCENTAGE=true
USE_ACCOUNT_EQUITY=false # If true, use account equity instead of initial capital for entry volume calculation
# Max concurrently open orders (OPENED/TP1). A LONG/SHORT that would exceed this is
# rejected: recorded + reported to the broker with status REJECTED (no order placed).
# A re-entry on an already-held symbol replaces it and does not count. 0 = disabled.
MAX_OPEN_ORDERS=0

# ─────────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG

# Notification
NOTIFICATION_MODE=VERBOSE # VERBOSE, SILENT, or ERROR

# ─────────────────────────────────────────────────────────────────
# Telegram
# TELEGRAM_CHAT_ID is for individual chat, manage service, nats worker notifications, etc.
# TELEGRAM_CHAT_CHANNEL_ID is for broadcasting channel as group includes Broker, Workers and administrators.
# ─────────────────────────────────────────────────────────────────
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHAT_CHANNEL_ID=  # Comma-separated list of channel IDs, e.g. -1001234567890,-1009876543210
# Forward log records at ERROR level or above to Telegram. When
# TELEGRAM_LOG_BOT_TOKEN / TELEGRAM_LOG_CHAT_ID are empty, the hook falls back
# to TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID.
TELEGRAM_LOG_ERRORS_ENABLED=false
TELEGRAM_LOG_DEDUP_WINDOW=60   # seconds — suppress identical messages
TELEGRAM_LOG_BOT_TOKEN=
TELEGRAM_LOG_CHAT_ID=
